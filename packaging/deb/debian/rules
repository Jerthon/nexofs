#!/usr/bin/make -f

# T5-13: mesma simplificação do RPM (T5-12) — build local via `cargo
# build`, sem vendorização das dependências. Não testado nesta máquina
# (sem dpkg-deb/toolchain Debian disponível); ver NexoFS_TASKS_v1.0.md.

export CARGO_HOME = $(CURDIR)/debian/.cargo-home

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked -p nexofsd -p nexofs-cli
	# T7-06: interface desktop no mesmo pacote (usuário pediu "tudo num único
	# instalador" em vez dos dois pacotes separados — nexofs + NexoFS —
	# que `cargo tauri build` gera por padrão, o segundo dependendo do
	# primeiro). `cargo build` direto no crate do Tauri funciona sozinho,
	# sem precisar da CLI `cargo-tauri`, desde que o `dist/` do frontend já
	# exista — só o `npm run build` (vite) é obrigatório antes.
	cd desktop && npm ci && npm run build
	cargo build --release --locked --features custom-protocol --manifest-path desktop/src-tauri/Cargo.toml

override_dh_auto_install:
	install -Dm755 target/release/nexofsd debian/nexofs/usr/bin/nexofsd
	install -Dm755 target/release/nexofs debian/nexofs/usr/bin/nexofs
	install -Dm644 packaging/systemd/nexofsd.service debian/nexofs/usr/lib/systemd/user/nexofsd.service
	install -Dm755 desktop/src-tauri/target/release/nexofs-desktop debian/nexofs/usr/bin/nexofs-desktop
	install -Dm644 packaging/desktop/NexoFS.desktop debian/nexofs/usr/share/applications/NexoFS.desktop
	install -Dm644 desktop/src-tauri/icons/32x32.png debian/nexofs/usr/share/icons/hicolor/32x32/apps/nexofs-desktop.png
	install -Dm644 desktop/src-tauri/icons/128x128.png debian/nexofs/usr/share/icons/hicolor/128x128/apps/nexofs-desktop.png
	install -Dm644 desktop/src-tauri/icons/128x128@2x.png debian/nexofs/usr/share/icons/hicolor/256x256@2/apps/nexofs-desktop.png
	install -Dm644 desktop/src-tauri/icons/icon.png debian/nexofs/usr/share/icons/hicolor/512x512/apps/nexofs-desktop.png

override_dh_auto_test:
	# Testes de verdade já rodam em CI/`cargo test --workspace`; o build
	# do pacote em si não precisa repeti-los.

override_dh_installsystemd:
	# Unidade de usuário (systemd --user), não de sistema — dh_installsystemd
	# desta versão do debhelper não tem suporte a --user; o arquivo já foi
	# instalado em override_dh_auto_install, então não há nada a fazer aqui
	# (mesmo efeito de --no-enable --no-start: sem trigger de ativação automática).

override_dh_strip_nondeterminism:
	# strip-nondeterminism não existe empacotado no Fedora (só Debian/Ubuntu);
	# etapa é só para builds reproduzíveis bit-a-bit, não afeta o pacote funcionar.

override_dh_shlibdeps:
	# dpkg-shlibdeps resolve contra o banco de pacotes dpkg, que não existe
	# nesta máquina Fedora (libgcc etc. vêm de RPM) — cálculo automático de
	# ${shlibs:Depends} não é confiável aqui. Depends já fixa libc6/libgcc-s1
	# manualmente no control; ver nota no changelog sobre validação real
	# pendente em Ubuntu/KDE Neon.
